# ============================================================
# tg-to-115 配置文件
# 复制为 .env 并填入实际值
# ============================================================

# --- Telegram API 凭证 (https://my.telegram.org/apps) ---
TG_API_ID=30431350
TG_API_HASH=dd31870e60686ad7b7fd01b2ac544259

# --- Session 文件名 (任意字符串，用于标识 session) ---
TG_SESSION_NAME=tg_to_115

# --- 转发目标群组 (TGdown) ---
TG_DEST_GROUP=-1004420616732

# --- Telegram 代理 (可选，格式: scheme://host:port) ---
# TG_PROXY=http://mihomo:7890
# TG_PROXY=socks5://127.0.0.1:1080

# --- 115 网盘 ---
# Cookie 文件路径 (容器内)
P115_COOKIE_FILE=/app/config/115-cookies.txt
# 115 上传目标目录
P115_TARGET_DIR=/beifen

# --- 通知 ---
# "me" = 收藏夹, 或指定 chat_id
NOTIFY_CHAT_ID=me

# --- 扫描间隔 (秒)，默认 30 分钟 ---
CHECK_INTERVAL=1800

# --- 下载临时目录 ---
TEMP_DIR=/app/temp
